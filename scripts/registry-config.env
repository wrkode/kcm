# KCM Registry Configuration
# This file contains configuration for building and pushing KCM images to your own registry
# Copy this file and modify the values as needed

# GitHub Container Registry configuration
REGISTRY=ghcr.io/wrkode/kcm
REGISTRY_REPO=oci://ghcr.io/wrkode/kcm/charts
REGISTRY_CI_REPO=oci://ghcr.io/wrkode/kcm/charts-ci

# Version configuration
# Leave empty to auto-detect from git
VERSION=
CHART_VERSION=

# GitHub authentication
# Set these environment variables before running the build script
# export GITHUB_TOKEN=your_github_token
# export GITHUB_USERNAME=your_github_username
GITHUB_TOKEN=
GITHUB_USERNAME=

# Docker configuration
DOCKER_BUILDKIT=1
DOCKER_DEFAULT_PLATFORM=linux/amd64

# Build configuration
BUILD_PLATFORMS=linux/amd64,linux/arm64
PUSH_PLATFORMS=linux/amd64,linux/arm64

# Chart configuration
CHART_NAME=kcm
CHART_DESCRIPTION="k0rdent Cluster Manager"

# Image names
CONTROLLER_IMAGE_NAME=controller
CI_IMAGE_NAME=controller-ci

# Example usage:
# 1. Copy this file: cp scripts/registry-config.env my-config.env
# 2. Edit my-config.env with your registry settings
# 3. Source the config: source my-config.env
# 4. Run the build script: ./scripts/build-and-push-images.sh 